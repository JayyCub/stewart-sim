#!/usr/bin/env python3
"""Surge the platform: slide it forward and back along x in a slow sine wave.

Usage:
  scripts/surge AMPLITUDE PERIOD [--cycles N] [--ignore-limits] [--port /dev/cu.usbmodemXXXX]

  AMPLITUDE  platform travel either side of home, mm (10 means -10..+10 mm)
  PERIOD     seconds for one full back-and-forth cycle

+x points from the platform centre to the front, between servos 1 and 6 (rig.json frontDeg).
Each leg gets its own horn angle from the shared IK (packages/kinematics), solved and
checked for the whole swing before anything moves. Stop with Ctrl+C: the platform eases
back home and holds. See scripts/axis_wave.py for the details and limits.
"""
import sys

from axis_wave import main

if __name__ == "__main__":
    sys.exit(main("x", "surge", "+x is the front, between servos 1 and 6"))

#!/usr/bin/env python3
"""Pitch the platform: tip it front to back about y in a slow sine wave.

Usage:
  scripts/pitch AMPLITUDE PERIOD [--cycles N] [--ignore-limits] [--port /dev/cu.usbmodemXXXX]

  AMPLITUDE  platform rotation either side of home, degrees (5 means -5..+5 deg)
  PERIOD     seconds for one full back-and-forth cycle

Positive pitch lowers the +x side (the front, servos 1 and 6) and raises the back (servos 3 and 4).
The rotation is about the centre of the top plate at ball-joint height; the platform
does not translate. Each leg gets its own horn angle from the shared IK
(packages/kinematics), solved and checked for the whole swing before anything moves.
Stop with Ctrl+C: the platform eases back home and holds. See scripts/axis_wave.py.
"""
import sys

from axis_wave import main

if __name__ == "__main__":
    sys.exit(main("pitch", "pitch", "positive lowers the front, servos 1 and 6"))

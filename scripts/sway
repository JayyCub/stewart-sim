#!/usr/bin/env python3
"""Sway the platform: slide it side to side along y in a slow sine wave.

Usage:
  scripts/sway AMPLITUDE PERIOD [--cycles N] [--ignore-limits] [--port /dev/cu.usbmodemXXXX]

  AMPLITUDE  platform travel either side of home, mm (10 means -10..+10 mm)
  PERIOD     seconds for one full side-to-side cycle

+y is 90 deg counter-clockwise from +x seen from above (toward servo 5; -y is toward servo 2).
Each leg gets its own horn angle from the shared IK (packages/kinematics), solved and
checked for the whole swing before anything moves. Stop with Ctrl+C: the platform eases
back home and holds. See scripts/axis_wave.py for the details and limits.
"""
import sys

from axis_wave import main

if __name__ == "__main__":
    sys.exit(main("y", "sway", "+y is 90 deg counter-clockwise from +x seen from above, toward servo 5"))
